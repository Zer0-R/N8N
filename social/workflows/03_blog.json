      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Le brouillon complet part aussi en fichier sur Telegram (lisible sans ouvrir l'e-mail).\nconst b = $('Composer e-mail').first().json;\nconst r = $json;\nreturn [{ json: { ...b, email_erreur: r.error ? (r.error.message || String(r.error)) : '' },\n          binary: { data: { data: Buffer.from(b.markdown, 'utf8').toString('base64'),\n                            mimeType: 'text/markdown', fileName: `${b.slug}.md`, fileExtension: 'md' } } }];\n"
      },
      "id": "a7eebf46-5144-59fe-a561-9cc96eeb27fa",
      "name": "Fichier .md",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

        "telegramApi": {
          "id": "TgVocabagBot0001",
          "name": "Telegram - vocabagbot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const e = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst cfg = $('Config').first().json;\nconst b = $('Fichier .md').first().json;\nconst av = (b.avertissements || []).length ? '\\n\\n⚠️ ' + b.avertissements.map(e).join('\\n⚠️ ') : '';\nconst mail = b.email_erreur ? `⚠️ E-mail non envoyé : ${e(b.email_erreur)}` : `📧 Brouillon complet envoyé à ${e(cfg.blog.email)}`;\nreturn [{ json: { id: b.id, texte:\n  `📝 <b>Nouveau brouillon de blog</b>\\n\\n<b>${e(b.titre)}</b>\\n${e(b.description)}\\n\\n` +\n  `${e(b.categorie)} · ${b.mots} mots · /blog/${e(b.slug)}${av}\\n\\n${mail}\\n\\n` +\n  `✅ Publier = commit sur la branche staging ; en ligne sur vocabag.com au prochain déploiement.` } }];\n"
      },

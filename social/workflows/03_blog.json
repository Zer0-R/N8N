        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {
          "caption": "=📝 {{ $json.titre }}"
        }
      },
      "id": "11b663bc-064c-58bc-ba62-d0bb9b6dddd0",
      "name": "Envoyer le fichier",
      "type": "n8n-nodes-base.telegram",
